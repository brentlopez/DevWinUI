<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ShimmerPanelPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dev="using:DevWinUI" xmlns:local="using:DevWinUIGallery" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ShimmerSkeletonBrush" Color="#FF424242" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShimmerSkeletonBrush" Color="#FFDADADA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ShimmerSkeletonBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="10" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0">
            <StackPanel dev:PanelAttach.ChildrenTransitions="Default" Spacing="10">

                <local:ControlExample HeaderText="ShimmerPanel over an image">
                    <local:ControlExample.Xaml>
                        <x:String>
                            &lt;dev:ShimmerPanel Width="120" Height="120" CornerRadius="8" IsActive="True"&gt;
                            &lt;Image Source="ms-appx:///Assets/Fluent/SwipeControl.png" Stretch="Uniform" /&gt;
                            &lt;/dev:ShimmerPanel&gt;
                        </x:String>
                    </local:ControlExample.Xaml>
                    <dev:ShimmerPanel Width="120" Height="120" Angle="{x:Bind AngleSlider.Value, Mode=OneWay}" BandWidth="{x:Bind WidthSlider.Value, Mode=OneWay}" CornerRadius="8" Easing="{x:Bind ToEasing(EasingCombo.SelectedItem), Mode=OneWay}" GradientShape="{x:Bind ToShape(ShapeCombo.SelectedItem), Mode=OneWay}" HighlightColor="{x:Bind GetHighlightColor(TGCustomColor.IsOn, ShimmerColorPicker.Color), Mode=OneWay}" HighlightOpacity="{x:Bind OpacitySlider.Value, Mode=OneWay}" IsActive="{x:Bind TGIsActive.IsOn, Mode=OneWay}" ReverseGradient="{x:Bind TGReverse.IsOn, Mode=OneWay}" Duration="{x:Bind GetDuration(SpeedSlider.Value), Mode=OneWay}">
                        <Image Source="ms-appx:///Assets/Fluent/SwipeControl.png" Stretch="Uniform" />
                    </dev:ShimmerPanel>
                </local:ControlExample>

                <local:ControlExample HeaderText="ShimmerPanel over a rectangle">
                    <local:ControlExample.Xaml>
                        <x:String>
                            &lt;dev:ShimmerPanel HorizontalAlignment="Left" IsActive="True"&gt;
                            &lt;Rectangle Width="300"
                            Height="120"
                            RadiusX="8"
                            RadiusY="8"
                            Fill="{ThemeResource ControlAltFillColorTertiaryBrush}" /&gt;
                            &lt;/dev:ShimmerPanel&gt;
                        </x:String>
                    </local:ControlExample.Xaml>
                    <dev:ShimmerPanel HorizontalAlignment="Left" Angle="{x:Bind AngleSlider.Value, Mode=OneWay}" BandWidth="{x:Bind WidthSlider.Value, Mode=OneWay}" Easing="{x:Bind ToEasing(EasingCombo.SelectedItem), Mode=OneWay}" GradientShape="{x:Bind ToShape(ShapeCombo.SelectedItem), Mode=OneWay}" HighlightColor="{x:Bind GetHighlightColor(TGCustomColor.IsOn, ShimmerColorPicker.Color), Mode=OneWay}" HighlightOpacity="{x:Bind OpacitySlider.Value, Mode=OneWay}" IsActive="{x:Bind TGIsActive.IsOn, Mode=OneWay}" ReverseGradient="{x:Bind TGReverse.IsOn, Mode=OneWay}" Duration="{x:Bind GetDuration(SpeedSlider.Value), Mode=OneWay}">
                        <Rectangle Width="300" Height="120" Fill="{ThemeResource ControlAltFillColorTertiaryBrush}" RadiusX="8" RadiusY="8" />
                    </dev:ShimmerPanel>
                </local:ControlExample>

                <local:ControlExample HeaderText="ShimmerPanel over a placeholder layout (skeleton card)">
                    <local:ControlExample.Xaml>
                        <x:String>
                            &lt;dev:ShimmerPanel HorizontalAlignment="Left" CornerRadius="8" IsActive="True"&gt;
                            &lt;Grid Width="320" Padding="12" ColumnSpacing="12"&gt;
                            &lt;Grid.ColumnDefinitions&gt;
                            &lt;ColumnDefinition Width="Auto" /&gt;
                            &lt;ColumnDefinition Width="*" /&gt;
                            &lt;/Grid.ColumnDefinitions&gt;
                            &lt;Ellipse Width="48" Height="48" Fill="{ThemeResource ControlAltFillColorTertiaryBrush}" /&gt;
                            &lt;StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8"&gt;
                            &lt;Rectangle Height="12" RadiusX="4" RadiusY="4" Fill="{ThemeResource ControlAltFillColorTertiaryBrush}" /&gt;
                            &lt;Rectangle Width="180" Height="12" HorizontalAlignment="Left" RadiusX="4" RadiusY="4" Fill="{ThemeResource ControlAltFillColorTertiaryBrush}" /&gt;
                            &lt;/StackPanel&gt;
                            &lt;/Grid&gt;
                            &lt;/dev:ShimmerPanel&gt;
                        </x:String>
                    </local:ControlExample.Xaml>
                    <dev:ShimmerPanel HorizontalAlignment="Left" Angle="{x:Bind AngleSlider.Value, Mode=OneWay}" BandWidth="{x:Bind WidthSlider.Value, Mode=OneWay}" CornerRadius="8" Easing="{x:Bind ToEasing(EasingCombo.SelectedItem), Mode=OneWay}" GradientShape="{x:Bind ToShape(ShapeCombo.SelectedItem), Mode=OneWay}" HighlightColor="{x:Bind GetHighlightColor(TGCustomColor.IsOn, ShimmerColorPicker.Color), Mode=OneWay}" HighlightOpacity="{x:Bind OpacitySlider.Value, Mode=OneWay}" IsActive="{x:Bind TGIsActive.IsOn, Mode=OneWay}" ReverseGradient="{x:Bind TGReverse.IsOn, Mode=OneWay}" Duration="{x:Bind GetDuration(SpeedSlider.Value), Mode=OneWay}">
                        <Grid Width="320" Padding="12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="48" Height="48" Fill="{ThemeResource ControlAltFillColorTertiaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <Rectangle Height="12" Fill="{ThemeResource ControlAltFillColorTertiaryBrush}" RadiusX="4" RadiusY="4" />
                                <Rectangle Width="180" Height="12" HorizontalAlignment="Left" Fill="{ThemeResource ControlAltFillColorTertiaryBrush}" RadiusX="4" RadiusY="4" />
                            </StackPanel>
                        </Grid>
                    </dev:ShimmerPanel>
                </local:ControlExample>

                <local:ControlExample HeaderText="Masked skeleton card (ShimmerMaskView) — a single sweep visible only over the placeholders">
                    <local:ControlExample.Xaml>
                        <x:String>
                            &lt;!--  The card surface is a parent Border; the placeholder shapes mask a single shimmer sweep.  --&gt;
                            &lt;Border Padding="12"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"&gt;
                            &lt;dev:ShimmerMaskView IsActive="True"&gt;
                            &lt;Grid Width="320" ColumnSpacing="12"&gt;
                            &lt;Grid.ColumnDefinitions&gt;
                            &lt;ColumnDefinition Width="Auto" /&gt;
                            &lt;ColumnDefinition Width="*" /&gt;
                            &lt;/Grid.ColumnDefinitions&gt;
                            &lt;Ellipse Width="48" Height="48" Fill="{ThemeResource ShimmerSkeletonBrush}" /&gt;
                            &lt;StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8"&gt;
                            &lt;Rectangle Height="12" RadiusX="4" RadiusY="4" Fill="{ThemeResource ShimmerSkeletonBrush}" /&gt;
                            &lt;Rectangle Width="180" Height="12" HorizontalAlignment="Left" RadiusX="4" RadiusY="4" Fill="{ThemeResource ShimmerSkeletonBrush}" /&gt;
                            &lt;/StackPanel&gt;
                            &lt;/Grid&gt;
                            &lt;/dev:ShimmerMaskView&gt;
                            &lt;/Border&gt;
                        </x:String>
                    </local:ControlExample.Xaml>
                    <Border Padding="12" HorizontalAlignment="Left" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <dev:ShimmerMaskView Angle="{x:Bind AngleSlider.Value, Mode=OneWay}" BandWidth="{x:Bind WidthSlider.Value, Mode=OneWay}" Easing="{x:Bind ToEasing(EasingCombo.SelectedItem), Mode=OneWay}" GradientShape="{x:Bind ToShape(ShapeCombo.SelectedItem), Mode=OneWay}" HighlightColor="{x:Bind GetHighlightColor(TGCustomColor.IsOn, ShimmerColorPicker.Color), Mode=OneWay}" HighlightOpacity="{x:Bind OpacitySlider.Value, Mode=OneWay}" IsActive="{x:Bind TGIsActive.IsOn, Mode=OneWay}" ReverseGradient="{x:Bind TGReverse.IsOn, Mode=OneWay}" Duration="{x:Bind GetDuration(SpeedSlider.Value), Mode=OneWay}">
                            <Grid Width="320" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="48" Height="48" Fill="{ThemeResource ShimmerSkeletonBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <Rectangle Height="12" Fill="{ThemeResource ShimmerSkeletonBrush}" RadiusX="4" RadiusY="4" />
                                    <Rectangle Width="180" Height="12" HorizontalAlignment="Left" Fill="{ThemeResource ShimmerSkeletonBrush}" RadiusX="4" RadiusY="4" />
                                </StackPanel>
                            </Grid>
                        </dev:ShimmerMaskView>
                    </Border>
                </local:ControlExample>

            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border Padding="16" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Width="280" Spacing="6">
                    <TextBlock Margin="0,0,0,4" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Settings (apply to all examples)" />
                    <ToggleSwitch x:Name="TGIsActive" Header="IsActive" IsOn="True" />
                    <Slider x:Name="AngleSlider" Header="Angle (°)" Maximum="90" Minimum="0" StepFrequency="1" Value="45" />
                    <Slider x:Name="WidthSlider" Header="Band width (px)" Maximum="400" Minimum="40" StepFrequency="1" Value="180" />
                    <Slider x:Name="SpeedSlider" Header="Speed (ms)" Maximum="4000" Minimum="400" StepFrequency="50" Value="1600" />
                    <Slider x:Name="OpacitySlider" Header="Opacity" Maximum="1" Minimum="0" StepFrequency="0.01" Value="0.2" />
                    <ComboBox x:Name="EasingCombo" HorizontalAlignment="Stretch" Header="Easing" ItemsSource="{x:Bind EasingValues}" SelectedIndex="0" />
                    <ComboBox x:Name="ShapeCombo" HorizontalAlignment="Stretch" Header="Gradient shape" ItemsSource="{x:Bind GradientShapeValues}" SelectedIndex="0" />
                    <ToggleSwitch x:Name="TGReverse" Header="Reverse gradient" IsOn="False" />
                    <ToggleSwitch x:Name="TGCustomColor" Header="Custom color" IsOn="False" />
                    <ColorPicker x:Name="ShimmerColorPicker" Width="260" IsAlphaEnabled="False" IsColorChannelTextInputVisible="False" IsMoreButtonVisible="False" Color="#FFFFFFFF" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>

